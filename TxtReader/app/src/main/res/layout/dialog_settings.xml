<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvFont"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text" />

        <SeekBar
            android:id="@+id/sbFont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="28" />

        <TextView
            android:id="@+id/tvLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text" />

        <SeekBar
            android:id="@+id/sbLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="150" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="背景"
            android:textColor="@color/text" />

        <LinearLayout
            android:id="@+id/bgRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swNight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="夜间模式"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="亮度"
            android:textColor="@color/text" />

        <SeekBar
            android:id="@+id/sbBright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <CheckBox
            android:id="@+id/cbBrightAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="跟随系统亮度"
            android:textColor="@color/text" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="音量键翻页"
            android:textColor="@color/text" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swReverse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="反转音量键方向"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/btnEncoding"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
